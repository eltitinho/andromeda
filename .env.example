# Andromeda Portal Configuration
# Copy this file to .env and update with your actual values

# Flask Secret Key (generate a new one for production)
SECRET_KEY=your-secret-key-here

# Database URL
DATABASE_URL=sqlite:///app.db

# =============================================================================
# Email Configuration Options
# Choose ONE of the following options
# =============================================================================

# Option 1: SMTP (legacy, still supported)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# Option 2: Mailgun HTTP API (recommended)
# Get your API key from: https://app.mailgun.com/app/sending/domains
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_BASE_DOMAIN=bforwarder.mbarque.space

# Note: For Mailgun, configure your subdomain via the web UI at /private/mailgun
# The full sending domain will be: {subdomain}.{MAILGUN_BASE_DOMAIN}
# Example: If subdomain=kristian and base=bforwarder.mbarque.space
#          Full domain = kristian@bforwarder.mbarque.space

# =============================================================================
# SMTP Provider Examples (for Option 1)
# =============================================================================
# Gmail:
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# Note: For Gmail, you may need to create an "App Password"
# See: https://support.google.com/accounts/answer/185833

# Outlook/Hotmail:
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USE_TLS=True

# Yahoo:
# MAIL_SERVER=smtp.mail.yahoo.com
# MAIL_PORT=587
# MAIL_USE_TLS=True

# Tuta:
# MAIL_SERVER=m.pop.tuta.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
